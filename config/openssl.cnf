[ req ]
default_bits       = 4096
default_md         = sha256
distinguished_name = req_distinguished_name
x509_extensions    = v3_req
prompt             = no

[ req_distinguished_name ]
C            = IN
ST           = Karnataka
L            = Bangalore
O            = Amrita
OU           = praneeth
CN           = 192.168.2.161

[ v3_req ]
subjectAltName = @alt_names

[ alt_names ]
IP.1          = 192.168.2.161



